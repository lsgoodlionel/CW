# 复制为 .env 后按需修改

# 对外访问端口(浏览器访问 http://服务器IP:HTTP_PORT)
HTTP_PORT=8080

# 升级/部署镜像来源:默认优先拉取 GHCR 预构建镜像(免服务器本地构建);
# 拉取失败会自动回退为本地构建。以下一般无需修改。
# BACKEND_IMAGE=ghcr.io/lsgoodlionel/cw-backend:latest
# FRONTEND_IMAGE=ghcr.io/lsgoodlionel/cw-frontend:latest
# FORCE_BUILD=1        # 设为 1 则强制本地构建(自定义代码/离线环境)

# 可选:本地构建后端时的 PyPI 镜像源(访问 pythonhosted 超时/国内网络慢时启用)
# 例:PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_INDEX_URL=

# PostgreSQL 凭据(生产环境务必修改密码)
POSTGRES_USER=finance
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=finance

# 允许的跨域来源,* 表示不限制(同源部署可保持 *)
CORS_ORIGINS=*

# 登录鉴权
REQUIRE_AUTH=true                 # 全站强制登录(true/false)
AUTH_SECRET=please-change-this-random-secret   # 令牌签名密钥,生产务必改成随机串
ADMIN_PASSWORD=admin123           # 初始超级管理员 admin 的密码(首次启动生效,之后请在系统内改)

# 部署模式与多租户(SaaS)
DEPLOY_MODE=private               # private=私有化单租户(默认,行为同单机版);saas=多租户
ALLOW_SELF_REGISTRATION=false     # 仅 saas 生效:是否开放访客自助注册开通租户
TRIAL_DAYS=30                     # 自助注册租户的试用天数

# 运行诊断:出错自动打包日志上传到共享 GitHub 仓库(供开发拉取排查;为空则不上传)
ERROR_REPORT_ENABLED=true         # 诊断总开关(仍需配置 token 才会真正上传)
PAPER_REPO=lsgoodlionel/paper     # owner/repo(多应用共用的日志仓库,建议设为 private)
PAPER_REPO_TOKEN=                 # GitHub PAT(需该仓库 contents 写权限);留空则功能禁用
PAPER_REPO_BRANCH=main
LOG_APP_SLUG=CW                   # 仓库内本应用目录:<slug>/logs/<UTC时间戳>.zip
ERROR_REPORT_COOLDOWN=600         # 同类错误上传冷却秒数(节流去重)
